# ScenarioEditorWeb 서버 (로컬 개발)
PORT=3100
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# 받을 Host 이름을 더한다(쉼표로 구분, 포트 제외). localhost·127.0.0.1·[::1] 은 항상 받는다. 이 PC 를 다른 이름으로 부를 때만 쓴다.
# 이 서버는 인증이 없다. HOST 를 바꿔 다른 PC 에 열면 같은 망의 누구나 설정 사용자로 쓰기 API 를 부를 수 있으니 바꾸지 않는다.
ALLOWED_HOSTS=

# EARS (공유 로컬 DB — 시험 데이터는 SEW 접두사로만)
MONGODB_URI=mongodb://localhost:27017/EARS
# 로그용 DB (WebManager 의 WEB_MANAGER 자리에 별도 DB)
WEBMANAGER_DB_URI=mongodb://localhost:27017/SE_WEB_DEV
# 1(기본)이면 위 DB 에 오류 기록을 남긴다. 0 이면 EARS 만 연결하고 기록을 끈다 — 사내 운영 EARS 읽기 시험용(.env.inhouse.example)
SE_WEBMANAGER_DB=1
# ars-redis (ARS docker/README.md 공용 인프라), 시나리오 해시는 DB0
REDIS_URL=redis://:visuallove@localhost:6379/0

# 사용자 (로그인 없음)
SE_USER_SINGLEID=sew_multi
# 개발 전용: 헤더 X-SE-User(이미지 경로는 ?seUser= 도)로 사용자 바꾸기 — 1 일 때만, 루프백에서 온 요청만. 기본 0.
# E2E·통합 시험은 1 을 직접 준다. 큰 시나리오 측정(open-big.js)은 서버를 SE_DEV_USER_OVERRIDE=1 로 띄운다.
SE_DEV_USER_OVERRIDE=0

# 웹 전용 DB = WEBMANAGER_DB_URI (초안·초안 그림·배포 기록도 여기에 둔다)

# InterfaceServer (infra/docker-compose.yml)
EARS_INTERFACE_URL=http://localhost:8080
EARS_INTERFACE_TIMEOUT_MS=15000
# 배포 요청 상한(MB, 검사 REQUEST_TOO_LARGE). InterfaceServer 의 http.parsing.max-content-length 와 같게 둔다 — 로컬 컨테이너는 512m(infra/is/conf/application.conf),
# 없으면 100(저장소 기본, 사내 값은 Q-006). BIG_200 배포 요청은 약 116MB 라 100 이면 막힌다.
EARS_INTERFACE_MAX_REQUEST_MB=512

# 캐시 (P1-C)
USER_CACHE_TTL_SEC=30
EQUIPMENT_CACHE_TTL_SEC=60
IMAGE_CACHE_DIR=./.cache/images
IMAGE_CACHE_MAX_MB=2048

LOG_DIR=./logs
