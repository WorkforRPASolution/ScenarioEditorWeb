# ScenarioEditorWeb 서버 설정 — 로컬 개발 프로필(맥, 로컬 EARS·Redis·InterfaceServer 컨테이너)
# 쓰는 법: cp server/.env.example server/.env
# 사내 PC 에서 운영 EARS 에 붙일 때는 이 파일이 아니라 server/.env.inhouse.example 을 쓴다(README).
#
# 두 예시 파일은 같은 구역 [1]~[10] 을 같은 순서로, 구역마다 같은 변수를 같은 순서로 둔다.
# 변수를 더하거나 옮기면 두 파일을 함께 고친다(tools/inhouse/__tests__/envExamples.test.js 가 본다).
# 한 프로필에서 읽지 않는 변수는 지우지 않고 "# 쓰지 않음: 이름 — 이유" 로 자리를 남긴다.

# ── [1] 서버 ──
PORT=3100
# 이 PC 에서만 받는다. 이 서버는 인증이 없다 — HOST 를 바꿔 다른 PC 에 열면 같은 망의 누구나 설정 사용자로 쓰기 API 를 부를 수 있으니 바꾸지 않는다.
HOST=127.0.0.1
NODE_ENV=development
# 화면(Vite) 주소. Vite 가 다른 포트로 뜨면 쉼표로 더한다.
ALLOWED_ORIGINS=http://localhost:5173
# 받을 Host 이름을 더한다(쉼표로 구분, 포트 제외). localhost·127.0.0.1·[::1] 은 항상 받는다. 이 PC 를 다른 이름으로 부를 때만 쓴다.
ALLOWED_HOSTS=

# ── [2] EARS Mongo ──
# 공유 로컬 DB — 시험 데이터는 SEW 접두사로만 넣는다.
MONGODB_URI=mongodb://localhost:27017/EARS

# ── [3] Redis ──
# ars-redis(ARS docker/README.md 공용 인프라). 시나리오 해시는 DB0.
REDIS_URL=redis://:visuallove@localhost:6379/0
# Sentinel 일 때만 더한다: REDIS_PASSWORD=<비밀번호>

# ── [4] 사용자 ──
# 로그인이 없다 — 이 SingleID 의 공정·권한으로 보인다.
SE_USER_SINGLEID=sew_multi
# 개발 전용: 헤더 X-SE-User(이미지 경로는 ?seUser= 도)로 사용자 바꾸기 — 1 일 때만, 루프백에서 온 요청만. 기본 0.
# E2E·통합 시험은 1 을 직접 준다. 큰 시나리오 측정(open-big.js)은 서버를 SE_DEV_USER_OVERRIDE=1 로 띄운다.
SE_DEV_USER_OVERRIDE=0

# ── [5] 웹 전용 DB ──
# 초안·초안 그림·배포 기록을 두는 DB. SE_WEBMANAGER_DB 값에 따라 주소를 읽는 변수가 다르다.
#   1(이 파일) → WEBMANAGER_DB_URI 를 읽는다. 서버 오류 기록(WEBMANAGER_LOG)도 그 DB 에 남긴다.
#   0(사내)    → SE_WEB_DB_URI 를 읽는다. 오류 기록은 남기지 않는다.
SE_WEBMANAGER_DB=1
# 반드시 SE_WEB_DEV — 비우면 연결 코드가 이 맥의 WebManager 기록 DB(mongodb://localhost:27017/WEB_MANAGER)로 떨어진다.
WEBMANAGER_DB_URI=mongodb://localhost:27017/SE_WEB_DEV
# 쓰지 않음: SE_WEB_DB_URI — SE_WEBMANAGER_DB=1 이면 읽지 않는다(웹 전용 DB = 위 WEBMANAGER_DB_URI)

# ── [6] InterfaceServer ──
# 저장·배포·삭제를 보내는 곳. 로컬은 infra/docker-compose.yml 의 컨테이너.
# http://<호스트>:<포트> 까지만 적는다(서버가 뒤에 /EARS/Interface 를 붙인다). 비우거나 줄이 없으면 http://localhost:8080 으로 보낸다.
EARS_INTERFACE_URL=http://localhost:8080
EARS_INTERFACE_TIMEOUT_MS=15000
# 배포 요청 상한(MB, 넘으면 검사가 REQUEST_TOO_LARGE 로 막는다). InterfaceServer 의 http.parsing.max-content-length 와 같게 둔다 —
# 로컬 컨테이너는 512m(infra/is/conf/application.conf). 줄이 없으면 100. BIG_200 배포 요청은 약 116MB 라 100 이면 막힌다.
EARS_INTERFACE_MAX_REQUEST_MB=512
# Vision·OCR 시험(P4)이 부르는 InterfaceServer 의 gRPC 판정 창구 — <호스트>:<포트> 만 적는다(http:// 없이).
# 로컬은 컨테이너의 9300 을 호스트 9310 에 연다(호스트 9300 은 Elasticsearch). 비우면 시험만 꺼진다("판정 시험 주소가 설정되지 않았습니다").
EARS_INTERFACE_GRPC_ADDR=127.0.0.1:9310
# 판정 시험의 시간 제한(ms). InterfaceServer 는 판정 서버를 10초까지 기다린다 — 그보다 조금 길게 둔다.
EARS_INTERFACE_GRPC_TIMEOUT_MS=12000
# 한꺼번에 도는 Vision 시험 수(1~16, 틀리면 2). OCR 시험은 늘 한 번에 하나, 사용자 한 명도 한 번에 하나다 — 판정 서버는 실제 설비 복구가 쓴다.
SE_VISION_TEST_CONCURRENCY=2
# 시험 실행(P5) — 설비에 시나리오 실행을 요청한다(위 EARS_INTERFACE_URL 의 /EARS/Action). 1 일 때만 받는다(아니면 버튼이 꺼지고 API 는 403).
# 로컬은 InterfaceServer 컨테이너가 CommandServer 흉내(tools/infra/fake-command-server.js, 3195)로 넘긴다 — 흉내가 떠 있지 않으면 "접수 여부 모름" 이다.
SE_TEST_RUN=1
# 실행 요청 한 건의 시간 제한(ms, 1000~60000 — 밖이면 12000). InterfaceServer 는 안에서 10초까지 기다린다 — 그보다 조금 길게 둔다.
EARS_ACTION_TIMEOUT_MS=12000
# 한 번에 실행할 설비 수(1~200, 밖이면 200).
SE_TEST_RUN_MAX_EQP=200
# 서버 전체에서 한꺼번에 보내는 실행 요청 수(1~5, 밖이면 1). InterfaceServer 는 실행 요청을 한 번에 하나씩 처리한다(실측) — 1 로 둔다.
SE_TEST_RUN_CONCURRENCY=1
# 같은 설비·시나리오를 "방금 요청함" 으로 보는 시간(분, 1~60, 밖이면 10) — 그 안에는 확인 창에서 따로 고를 때만 다시 보낸다.
SE_TEST_RUN_RECENT_MIN=10
# 실행 상태를 찾을 때의 시각 여유(초, 0~3600, 밖이면 120) — CommandServer 와 이 서버의 시계가 다를 수 있다.
SE_TEST_RUN_CLOCK_SKEW_SEC=120

# ── [7] 캐시 ──
USER_CACHE_TTL_SEC=30
EQUIPMENT_CACHE_TTL_SEC=60
# 시나리오를 처음 열 때 푼 기준 화면·뼈대를 여기 둔다. 상한을 넘으면 오래 안 쓴 것부터 지운다.
IMAGE_CACHE_DIR=./.cache/images
IMAGE_CACHE_MAX_MB=2048

# ── [8] 로그 ──
LOG_DIR=./logs

# ── [9] 안내 링크 ──
# 전처리 설정 창 머리에 보이는 안내 문서 주소(http:// 또는 https://). 비우면 링크를 보이지 않는다.
SE_LINK_PREPROCESSING_SOP=

# ── [10] 스냅샷·이력 ──
# 스냅샷 목록·그림은 Cassandra(키스페이스 ars 의 snapshotlist·snapshot)를 읽기만 한다. 비우면 스냅샷 패널이 "주소 미설정" 을 보인다.
# 여러 대면 쉼표로 잇는다(호스트만 — 포트는 아래).
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
# 드라이버가 요구하는 데이터센터 이름. cqlsh 에서 select data_center from system.local; 로 본다.
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=ars
# 읽기만 하면 되는 계정. 로컬 컨테이너(my-cassandra-server) 계정은 ARS 루트 docker/README.md "Cassandra" 절에 있다 — 여기 예시에는 적지 않는다.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
# 스냅샷 서버(ARSSnapShotServer) JVM 시간대 — 그림이 든 날짜 파티션을 이 시간대로 계산한다.
SE_SNAPSHOT_PARTITION_TZ=Asia/Seoul
# 화면에 보이는 스냅샷 시각의 시간대(설비 보정 snapshotTimeDiff 는 따로 더한다).
SE_DISPLAY_TZ=Asia/Seoul
# 설비 고르기의 스냅샷 유무 표시(공정·모델 옆 "있는 설비 수 / 전체", 설비 줄의 가장 늦은 날짜) — 설비마다 한두 줄씩 읽을 때
# 한꺼번에 보내는 조회 수(기본 8, 최대 64). 이 서버 프로세스 안에서 이 수를 넘지 않고, 받은 값은 10분 기억한다. 0 이면 표시를 끈다.
# 설비 고르기 칸에 들어갈 때만 받기 시작한다(패널을 펴기만 해서는 묻지 않는다).
SE_SNAPSHOT_PRESENCE_CONCURRENCY=8
# 자동 복구 이력 서버(HttpWebServer) http://호스트:포트. 비우면 이력 보기만 꺼진다.
# 로컬은 infra/docker-compose.yml 의 http-web-server(tools/infra/prepare-hws.sh 로 준비) — 시험 이력 넣기(seed -- snapshots)도 이 주소를 쓴다.
HTTP_WEB_SERVER_URL=http://127.0.0.1:8082
