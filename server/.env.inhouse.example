# ScenarioEditorWeb 서버 — 사내 운영 EARS 에 붙여 읽기만 하는 시험. 절차는 README "사내 운영 DB 로 읽기 시험".
# 쓰는 법: 이 파일을 server/.env 로 복사하고 <...> 를 채운다(.env 는 git 에 들어가지 않는다).
PORT=3100
# 이 PC 에서만 받는다. 인증 없는 서버이므로 바꾸지 않는다.
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# 운영 EARS (읽기만 한다). 연결 코드가 WebManager 와 같으므로 사내 WebManager 의 MONGODB_URI 형식을 그대로 쓴다.
# 읽기 전용 계정이 있으면 그것을 쓴다.
MONGODB_URI=mongodb://<계정>:<비밀번호>@<운영 Mongo 호스트>:<포트>/EARS
# 반드시 0 — WEBMANAGER DB 를 연결하지 않고 오류 기록 저장을 끈다. 이 값이 없거나 1 이면 WEBMANAGER_DB_URI 에 기록을 쓴다.
SE_WEBMANAGER_DB=0

# 운영 Redis DB0 (시나리오 해시 HKEYS 만). 사내 WebManager 의 REDIS_URL·REDIS_PASSWORD 형식을 그대로 쓴다.
#   단일: redis://:<비밀번호>@<호스트>:6379/0
#   Sentinel: {<호스트>:<포트>},{<호스트>:<포트>}#<master 이름>  + REDIS_PASSWORD=<비밀번호>
REDIS_URL=redis://:<비밀번호>@<운영 Redis 호스트>:6379/0

# 사용자 (로그인 없음): 운영 ARS_USER_INFO 에 있는 본인 SingleID. 이 사용자의 공정·권한으로 보인다.
SE_USER_SINGLEID=<본인 SingleID>
# 1 이면 브라우저 localStorage se-dev-user 로 다른 사용자로 볼 수 있다(이 PC 의 요청만 듣는다).
SE_DEV_USER_OVERRIDE=0

# P1 은 InterfaceServer 를 부르지 않는다(EARS_INTERFACE_URL 불필요).

USER_CACHE_TTL_SEC=30
EQUIPMENT_CACHE_TTL_SEC=60
# 시나리오를 처음 열 때 푼 기준 화면·뼈대를 여기 둔다. 상한을 넘으면 오래 안 쓴 것부터 지운다.
IMAGE_CACHE_DIR=./.cache/images
IMAGE_CACHE_MAX_MB=2048

LOG_DIR=./logs
