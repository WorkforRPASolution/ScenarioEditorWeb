# ScenarioEditorWeb 서버 — 사내 운영 EARS 에 붙이는 시험. 읽기 시험은 README "사내 운영 DB 로 읽기 시험", 쓰기(저장·배포) 시험은 "사내 쓰기 시험".
# 쓰는 법: 이 파일을 server/.env 로 복사하고 <...> 를 채운다(.env 는 git 에 들어가지 않는다).
# 쓰기 시험 전에는 node tools/inhouse/preflight.js 로 이 파일을 점검한다(멈춤이 있으면 시험하지 않는다).
PORT=3100
# 이 PC 에서만 받는다. 인증 없는 서버이므로 바꾸지 않는다.
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# 운영 EARS. 연결 코드가 WebManager 와 같으므로 사내 WebManager 의 MONGODB_URI 형식을 그대로 쓴다.
# 읽기 전용 계정이 있으면 그것을 쓴다. 쓰기 시험의 저장·배포·삭제는 InterfaceServer 가 쓰므로 읽기 전용 계정으로 된다.
# 켜기·끄기(불러오기 창)·심의·성과 저장만 SC_PROPERTY 에 직접 쓴다(읽기 전용 계정이면 실패 — 쓰기 시험 절차에 넣지 않았다).
MONGODB_URI=mongodb://<계정>:<비밀번호>@<운영 Mongo 호스트>:<포트>/EARS
# 반드시 0 — WEBMANAGER DB 를 연결하지 않고 오류 기록 저장을 끈다. 이 값이 없거나 1 이면 WEBMANAGER_DB_URI 에 기록을 쓴다.
SE_WEBMANAGER_DB=0

# 운영 Redis DB0 (시나리오 해시 HKEYS 만). 사내 WebManager 의 REDIS_URL·REDIS_PASSWORD 형식을 그대로 쓴다.
#   단일: redis://:<비밀번호>@<호스트>:6379/0
#   Sentinel: {<호스트>:<포트>},{<호스트>:<포트>}#<master 이름>  + REDIS_PASSWORD=<비밀번호>
REDIS_URL=redis://:<비밀번호>@<운영 Redis 호스트>:6379/0

# 사용자 (로그인 없음): 운영 ARS_USER_INFO 에 있는 본인 SingleID. 이 사용자의 공정·권한으로 보인다. 쓰기 시험은 WRITE 권한이 있어야 한다.
SE_USER_SINGLEID=<본인 SingleID>
# 반드시 0 — 1 이면 브라우저 localStorage se-dev-user 로 다른 사용자로 바꿔 저장할 수 있다(이 PC 의 요청만 듣는다).
SE_DEV_USER_OVERRIDE=0

# 웹 전용 DB(초안·초안 그림·배포 기록). 쓰기 시험에서 채운다: 운영 EARS 가 아닌 다른 DB 이름(예 mongodb://<계정>:<비밀번호>@<호스트>:<포트>/SE_WEB_TEST?authSource=admin),
# 계정은 그 DB 에 쓰기 권한. DB 이름이 EARS 와 같으면(대소문자 무시) 서버가 뜨지 않는다. 채웠는데 연결하지 못해도 서버가 뜨지 않는다.
# 읽기 시험만 하면 비워 둔다 — 연결하지 않고 쓰기 API 는 503 이다.
SE_WEB_DB_URI=
# 사내 InterfaceServer(사내 WebManager 설정과 같은 값). 쓰기(저장·배포·삭제) 시험에서만 부른다.
EARS_INTERFACE_URL=http://<사내 InterfaceServer 호스트>:<포트>
# 배포 요청 크기 상한(MB). 사내 InterfaceServer 의 max-content-length 에 맞춘다 — 모르면 100 그대로(분석 42 Q-006).
EARS_INTERFACE_MAX_REQUEST_MB=100

USER_CACHE_TTL_SEC=30
EQUIPMENT_CACHE_TTL_SEC=60
# 시나리오를 처음 열 때 푼 기준 화면·뼈대를 여기 둔다. 상한을 넘으면 오래 안 쓴 것부터 지운다. 기본값이면 사전 점검이 경고한다(디스크 여유 확인).
IMAGE_CACHE_DIR=./.cache/images
IMAGE_CACHE_MAX_MB=2048

LOG_DIR=./logs
